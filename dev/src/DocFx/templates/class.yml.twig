### YamlMime:UniversalReference
items:
- uid: {{fullname}}
  name: {{name}}
  id: {{name}}
  summary: {{summary}}
  type: class
  langs:
  - php
  children:
{% for method in methods %}
  - {{fullname}}::{{method.name}}()
{% endfor %}
{% if status %}
  status: {{ status }}
{% endif %}
{% if inheritedMembers|length > 0 %}
  inheritedMembers:
{% for inheritedMember in inheritedMembers %}
  - {{inheritedMember}}
{% endfor %}
{% endif %}
{% if implements|length > 0 %}
  implements:
{% for interface in implements %}
  - {{interface}}
{% endfor %}
{% endif %}
{% if properties|length > 0 %}
  properties:
{% for property in properties %}
  - type: {{property.type}}
    name: {{property.name}}
{% endfor %}
{% endif %}
{% for method in methods %}
- uid: {{fullname}}::{{method.name}}()
  name: {{method.name}}
  id: {{method.name}}
{% if method.summary %}
  summary: {{method.summary}}
{% endif %}
  parent: {{fullname}}
  type: method
  langs:
  - php
{% if method.parameters|length > 0 %}
  parameters:
{% for parameter in method.parameters %}
  - type: {{parameter.type}}
    name: {{parameter.name}}
{% if parameter.description %}
    description: {{parameter.description}}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
