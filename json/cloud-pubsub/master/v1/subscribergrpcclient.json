,{"name":"metadata","description":"<p>metadata<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null},{"name":"options","description":"<p>call options<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null}],"exceptions":[],"returns":[{"types":["\\Grpc\\UnaryCall"],"description":""}]},{"id":"ModifyAckDeadline","type":"instance","name":"ModifyAckDeadline","source":"PubSub\/src\/V1\/SubscriberGrpcClient.php#L138","description":"<p>Modifies the ack deadline for a specific message. This method is useful\nto indicate that more time is needed to process a message by the\nsubscriber, or to make the message available for redelivery if the\nprocessing was interrupted. Note that this does not modify the\nsubscription-level <code>ackDeadlineSeconds<\/code> used for subsequent messages.<\/p>","examples":[],"resources":[],"params":[{"name":"argument","description":"<p>input argument<\/p>","types":["<a data-custom-type=\"cloud-pubsub\/master\/pubsub\/v1\/modifyackdeadlinerequest\">Google\\Cloud\\PubSub\\V1\\ModifyAckDeadlineRequest<\/a>"],"optional":false,"nullable":null},{"name":"metadata","description":"<p>metadata<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null},{"name":"options","description":"<p>call options<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null}],"exceptions":[],"returns":[{"types":["\\Grpc\\UnaryCall"],"description":""}]},{"id":"Acknowledge","type":"instance","name":"Acknowledge","source":"PubSub\/src\/V1\/SubscriberGrpcClient.php#L159","description":"<p>Acknowledges the messages associated with the <code>ack_ids<\/code> in the\n<code>AcknowledgeRequest<\/code>. The Pub\/Sub system can remove the relevant messages\nfrom the subscription.<\/p>","examples":[],"resources":[],"params":[{"name":"argument","description":"<p>input argument<\/p>","types":["<a data-custom-type=\"cloud-pubsub\/master\/pubsub\/v1\/acknowledgerequest\">Google\\Cloud\\PubSub\\V1\\AcknowledgeRequest<\/a>"],"optional":false,"nullable":null},{"name":"metadata","description":"<p>metadata<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null},{"name":"options","description":"<p>call options<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null}],"exceptions":[],"returns":[{"types":["\\Grpc\\UnaryCall"],"description":""}]},{"id":"Pull","type":"instance","name":"Pull","source":"PubSub\/src\/V1\/SubscriberGrpcClient.php#L176","description":"<p>Pulls messages from the server. The server may return <code>UNAVAILABLE<\/code> if\nthere are too many concurrent pull requests pending for the given\nsubscription.<\/p>","examples":[],"resources":[],"params":[{"name":"argument","description":"<p>input argument<\/p>","types":["<a data-custom-type=\"cloud-pubsub\/master\/pubsub\/v1\/pullrequest\">Google\\Cloud\\PubSub\\V1\\PullRequest<\/a>"],"optional":false,"nullable":null},{"name":"metadata","description":"<p>metadata<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null},{"name":"options","description":"<p>call options<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null}],"exceptions":[],"returns":[{"types":["\\Grpc\\UnaryCall"],"description":""}]},{"id":"StreamingPull","type":"instance","name":"StreamingPull","source":"PubSub\/src\/V1\/SubscriberGrpcClient.php#L196","description":"<p>Establishes a stream with the server, which