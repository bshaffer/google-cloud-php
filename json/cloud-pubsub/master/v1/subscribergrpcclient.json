b\/src\/V1\/SubscriberGrpcClient.php#L233","description":"<p>Gets the configuration details of a snapshot. Snapshots are used in\n<a href=\"https:\/\/cloud.google.com\/pubsub\/docs\/replay-overview\">Seek<\/a>\noperations, which allow you to manage message acknowledgments in bulk. That\nis, you can set the acknowledgment state of messages in an existing\nsubscription to the state captured by a snapshot.<\/p>","examples":[],"resources":[],"params":[{"name":"argument","description":"<p>input argument<\/p>","types":["<a data-custom-type=\"cloud-pubsub\/master\/pubsub\/v1\/getsnapshotrequest\">Google\\Cloud\\PubSub\\V1\\GetSnapshotRequest<\/a>"],"optional":false,"nullable":null},{"name":"metadata","description":"<p>metadata<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null},{"name":"options","description":"<p>call options<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null}],"exceptions":[],"returns":[{"types":["\\Grpc\\UnaryCall"],"description":""}]},{"id":"ListSnapshots","type":"instance","name":"ListSnapshots","source":"PubSub\/src\/V1\/SubscriberGrpcClient.php#L252","description":"<p>Lists the existing snapshots. Snapshots are used in <a href=\"https:\/\/cloud.google.com\/pubsub\/docs\/replay-overview\">Seek<\/a> operations, which\nallow you to manage message acknowledgments in bulk. That is, you can set\nthe acknowledgment state of messages in an existing subscription to the\nstate captured by a snapshot.<\/p>","examples":[],"resources":[],"params":[{"name":"argument","description":"<p>input argument<\/p>","types":["<a data-custom-type=\"cloud-pubsub\/master\/pubsub\/v1\/listsnapshotsrequest\">Google\\Cloud\\PubSub\\V1\\ListSnapshotsRequest<\/a>"],"optional":false,"nullable":null},{"name":"metadata","description":"<p>metadata<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null},{"name":"options","description":"<p>call options<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null}],"exceptions":[],"returns":[{"types":["\\Grpc\\UnaryCall"],"description":""}]},{"id":"CreateSnapshot","type":"instance","name":"CreateSnapshot","source":"PubSub\/src\/V1\/SubscriberGrpcClient.php#L282","description":"<p>Creates a snapshot from the requested subscription. Snapshots are used in\n<a href=\"https:\/\/cloud.google.com\/pubsub\/docs\/replay-overview\">Seek<\/a> operations,\nwhich allow you to manage message acknowledgments in bulk. That is, you can\nset the acknowledgment state of messages in an existing subscription to the\nstate captured by a snapshot.<\/p>","examples":[],"resources":[],"params":[{"name":"argument","description":"<p>input argument<\/p>","types":["<a data-custom-type=\"cloud-pubsub\/master\/pubsub\/v1\/createsnapshotrequest\">Google\\Cloud\\PubSub\\V1\\CreateSnapshotRequest<\/a>"],"optional":false,"nullable":null},{"name":"metadata","description":"<p>metadata<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null},{"name":"options","description":"<p>call options<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null}],"exceptions":[],"returns":[{"types":["\\Grpc\\UnaryCall"],"description":""}]},{"id":"UpdateSnapshot","type":"instance","name":"UpdateSnapshot","source":"PubSub\/src\/V1\/SubscriberGrpcClient.php#L302","description":"<p>Updates an existing snapshot. Snapshots are used in\n<a href=\"https:\/\/cloud.google.com\/pubsub\/docs\/replay-overview\">Seek<\/a>\noperations, which allow\nyou to manage message acknowledgments in bulk. That is, you can set the\nacknowledgment state of messages in an existing subscription to the state\ncaptured by a snapshot.<\/p>","examples":[],"resources":[],"params":[{"name":"argument","description":"<p>input argument<\/p>","types":["<a data-custom-type=\"cloud-pubsub\/master\/pubsub\/v1\/updatesnapshotrequest\">Google\\Cloud\\PubSub\\V1\\UpdateSnapshotRequest<\/a>"],"optional":false,"nullable":null},{"name":"metadata","description":"<p>metadata<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null},{"name":"options","description":"<p>call options<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null}],"exceptions":[],"returns":[{"types":["\\Grpc\\UnaryCall"],"description":""}]},{"id":"DeleteSnapshot","type":"instance","name":"DeleteSnapshot","source":"PubSub\/src\/V1\/SubscriberGrpcClient.php#L325","description":"<p>Removes an existing snapshot. Snapshots are used in [Seek]\n(<a href=\"https:\/\/cloud.google.com\/pubsub\/docs\/replay-overview\">https:\/\/cloud.google.com\/pubsub\/docs\/replay-overview<\/a>) operations, which\nallow you to manage message acknowledgments in bulk. That is, you can set\nthe acknowledgment state of messages in an existing subscription to the\nstate captured by a snapshot.<\/p>","examples":[],"resources":[],"params":[{"name":"argument","description":"<p>input argument<\/p>","types":["<a data-custom-type=\"cloud-pubsub\/master\/pubsub\/v1\/deletesnapshotrequest\">Google\\Cloud\\PubSub\\V1\\DeleteSnapshotRequest<\/a>"],"optional":false,"nullable":null},{"name":"metadata","description":"<p>metadata<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null},{"name":"options","description":"<p>call options<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null}],"exceptions":[],"returns":[{"types":["\\Grpc\\UnaryCall"],"description":""}]},{"id":"Seek","type":"instance","name":"Seek","source":"PubSub\/src\/V1\/SubscriberGrpcClient.php#L346","description":"<p>Seeks an existing subscription to a point in time or to a given snapshot,\nwhichever is provided in the request. Snapshots are used in [Seek]\n(<a href=\"https:\/\/cloud.google.com\/pubsub\/docs\/replay-overview\">https:\/\/cloud.google.com\/pubsub\/docs\/replay-overview<\/a>) operations, which\nallow you to manage message acknowledgments in bulk. That is, you can set\nthe acknowledgment state of messages in an existing subscription to the\nstate captured by a snapshot. Note that both the subscription and the\nsnapshot must be on the same topic.<\/p>","examples":[],"resources":[],"params":[{"name":"argument","description":"<p>input argument<\/p>","types":["<a data-custom-type=\"cloud-pubsub\/master\/pubsub\/v1\/seekrequest\">Google\\Cloud\\PubSub\\V1\\SeekRequest<\/a>"],"optional":false,"nullable":null},{"name":"metadata","description":"<p>metadata<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null},{"name":"options","description":"<p>call options<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null}],"exceptions":[],"returns":[{"types":["\\Grpc\\UnaryCall"],"description":""}]}]}