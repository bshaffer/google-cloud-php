{"id":"talent\/v4beta1\/jobapplication","type":"","title":"Google\\Cloud\\Talent\\V4beta1\\JobApplication","name":"JobApplication","description":"<p>Resource that represents a job application record of a candidate.<\/p>","examples":[],"resources":[],"methods":[{"id":"__construct","type":"constructor","name":"__construct","source":"Talent\/src\/V4beta1\/JobApplication.php#L193","description":"<p>Constructor.<\/p>","examples":[],"resources":[],"params":[{"name":"data","description":"<p>Optional. Data for populating the Message object.<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null},{"name":"data.job\n","description":"<p>Optional. The information of job which the candidate applied for. If [Job.name][google.cloud.talent.v4beta1.Job.name] is provided, the corresponding [Job][google.cloud.talent.v4beta1.Job] must be created. Otherwise, only [Job.requisition_id][google.cloud.talent.v4beta1.Job.requisition_id], [Job.title][google.cloud.talent.v4beta1.Job.title], [Job.description][google.cloud.talent.v4beta1.Job.description] and [Job.addresses][google.cloud.talent.v4beta1.Job.addresses] provided here are persisted in the application. No [Job][google.cloud.talent.v4beta1.Job] entity is created in this case.<\/p>","types":["<a data-custom-type=\"cloud-talent\/master\/talent\/v4beta1\/job\">Google\\Cloud\\Talent\\V4beta1\\Job<\/a>"],"optional":null,"nullable":null},{"name":"data.application_id\n","description":"<p>Optional. The job application id. Number of characters allowed is 100.<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.string.php\" target=\"_blank\">string<\/a>"],"optional":null,"nullable":null},{"name":"data.application_date\n","description":"<p>Optional. The application date.<\/p>","types":["<a href=\"https:\/\/googleapis.github.io\/gax-php\/v1.7.1\/Google\/Type\/Date.html\" target=\"_blank\">Google\\Type\\Date<\/a>"],"optional":null,"nullable":null},{"name":"data.last_stage\n","description":"<p>Optional. The last stage the candidate reached in the application progress. For example, &quot;new&quot;, &quot;phone screen&quot;, &quot;interview&quot;.<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.string.php\" target=\"_blank\">string<\/a>"],"optional":null,"nullable":null},{"name":"data.state\n","description":"<p>Optional. The application state.<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.integer.php\" target=\"_blank\">int<\/a>"],"optional":null,"nullable":null},{"name":"data.average_interview_score\n","description":"<p>Optional. The average interview score.<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.float.php\" target=\"_blank\">float<\/a>"],"optional":null,"nullable":null},{"name":"data.interview_score_scale_id\n","description":"<p>Optional. The scale id of the interview score. Number of characters allowed is 100.<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.string.php\" target=\"_blank\">string<\/a>"],"optional":null,"nullable":null},{"name":"data.number_of_interviews\n","description":"<p>Optional. The number of interviews.<\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.integer.php\" target=\"_blank\">int<\/a>"],"optional":null,"nullable":null},{"name":"data.is_employee_referred\n","description":"<p>Optional. If the candidate is referred by a employee.<\/p>","types":["<a href=\"https:\/\/github.com\/protocolbuffers\/protobuf-php\/tree\/v3.15.8\/src\/Google\/Protobuf\/BoolValue.php\" target=\"_blank\">Google\\Protobuf\\BoolValue<\/a>"],"optional":null,"nullable":null},{"name":"data.update_time\n","description":"<p>Optional. The last update timestamp.<\/p>","types":["<a href=\"https:\/\/github.com\/protocolbuffers\/protobuf-php\/tree\/v3.15.8\/src\/Google\/Protobuf\/Timestamp.php\" target=\"_blank\">Google\\Protobuf\\Timestamp<\/a>"],"optional":null,"nullable":null},{"name":"dat