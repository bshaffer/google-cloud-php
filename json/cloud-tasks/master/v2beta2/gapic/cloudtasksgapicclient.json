],"returns":[{"types":["<a data-custom-type=\"cloud-tasks\/master\/tasks\/v2beta2\/leasetasksresponse\">Google\\Cloud\\Tasks\\V2beta2\\LeaseTasksResponse<\/a>"],"description":""}]},{"id":"acknowledgeTask","type":"instance","name":"acknowledgeTask","source":"Tasks\/src\/V2beta2\/Gapic\/CloudTasksGapicClient.php#L1671","description":"<p>Acknowledges a pull task.<\/p>","examples":[],"resources":[],"params":[{"name":"name","description":"<p>Required. The task name. For example:\n<code>projects\/PROJECT_ID\/locations\/LOCATION_ID\/queues\/QUEUE_ID\/tasks\/TASK_ID<\/code><\/p>","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.string.php\" target=\"_blank\">string<\/a>"],"optional":false,"nullable":null},{"name":"scheduleTime","description":"<p>Required. The task's current schedule time, available in the\n[schedule_time][google.cloud.tasks.v2beta2.Task.schedule_time] returned by\n[LeaseTasks][google.cloud.tasks.v2beta2.CloudTasks.LeaseTasks] response or\n[RenewLease][google.cloud.tasks.v2beta2.CloudTasks.RenewLease] response. This restriction is\nto ensure that your worker currently holds the lease.<\/p>","types":["<a href=\"https:\/\/github.com\/protocolbuffers\/protobuf-php\/tree\/v3.15.8\/src\/Google\/Protobuf\/Timestamp.php\" target=\"_blank\">Google\\Protobuf\\Timestamp<\/a>"],"optional":false,"nullable":null},{"name":"optionalArgs","description":"","types":["<a href=\"http:\/\/php.net\/manual\/en\/language.types.array.php\" target=\"_blank\">array<\/a>"],"optional":false,"nullable":null},{"name":"optionalArgs.retrySettings\n","description":"","types":["|"],"optional":null,"nullable":null}],"exceptions":[{"type":{},"description":{}}],"returns":[]},{"id":"renewLease","type":"instance","name":"renewLease","source":"Tasks\/src\/V2beta2\/Gapic\/CloudTasksGapicClient.php#L1749","description":"<p>Renew the current lease of a pull task.<\/p>","examples":[],"resources":[],"params":[{"name":"name","description":"<p>Required. The task name. For example:\n<code>p